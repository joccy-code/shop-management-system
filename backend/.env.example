# Copy this file to .env and fill in local values.
# Never commit real secrets.

NODE_ENV=development
PORT=3001
APP_NAME=Shop Manager
APP_CURRENCY=ETB
APP_TIMEZONE=Africa/Addis_Ababa

# PostgreSQL connection string for this app only.
# Example for a local database named shop_manager:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/shop_manager?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/shop_manager?schema=public

# Session cookie settings
SESSION_COOKIE_NAME=shop_manager_session
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Frontend origin used for CORS in production-like local setups.
# Leave empty when the Vite proxy serves the UI from the same origin.
CORS_ORIGIN=http://127.0.0.1:5173

# Structured logging: "info" | "debug" | "warn" | "error"
LOG_LEVEL=info
