generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserRole {
  OWNER
  STAFF
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  SALE
  ADJUSTMENT
  PURCHASE
  RETURN
  INITIAL
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_PAID
  UNPAID
  VOIDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  TELEBIRR
  OTHER
  CREDIT
}

enum PaymentStatus {
  RECORDED
  VOIDED
}

enum ExpenseStatus {
  RECORDED
  VOIDED
}

enum SubscriptionStatus {
  NONE
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

model Shop {
  id        String     @id @default(cuid())
  name      String
  status    ShopStatus @default(ACTIVE)
  timezone  String     @default("Africa/Addis_Ababa")
  currency  String     @default("ETB")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  users               User[]
  categories          Category[]
  products            Product[]
  inventoryMovements  InventoryMovement[]
  sales               Sale[]
  payments            Payment[]
  expenses            Expense[]
  customers           Customer[]
  customerRepayments  CustomerRepayment[]
  subscription        Subscription?

  @@map("shops")
}

model User {
  id           String   @id @default(cuid())
  shopId       String   @map("shop_id")
  phone        String
  email        String?
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(OWNER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sessions Session[]
  sales    Sale[]

  @@unique([phone])
  @@index([shopId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([shopId, name])
  @@index([shopId])
  @@map("categories")
}

model Product {
  id                String        @id @default(cuid())
  shopId            String        @map("shop_id")
  categoryId        String?       @map("category_id")
  name              String
  sku               String?
  sellingPrice      Decimal       @map("selling_price") @db.Decimal(12, 2)
  unitCost          Decimal       @map("unit_cost") @db.Decimal(12, 2)
  stockQuantity     Decimal       @map("stock_quantity") @db.Decimal(12, 3)
  lowStockThreshold Decimal       @default(0) @map("low_stock_threshold") @db.Decimal(12, 3)
  unitOfMeasure     String?       @map("unit_of_measure")
  status            ProductStatus @default(ACTIVE)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]

  @@index([shopId, status])
  @@index([shopId, name])
  @@index([shopId, sku])
  @@index([categoryId])
  @@map("products")
}

model InventoryMovement {
  id             String                 @id @default(cuid())
  shopId         String                 @map("shop_id")
  productId      String                 @map("product_id")
  type           InventoryMovementType
  quantityChange Decimal                @map("quantity_change") @db.Decimal(12, 3)
  quantityAfter  Decimal                @map("quantity_after") @db.Decimal(12, 3)
  reason         String?
  referenceType  String?                @map("reference_type")
  referenceId    String?                @map("reference_id")
  createdAt      DateTime               @default(now()) @map("created_at")

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt])
  @@index([productId, createdAt])
  @@map("inventory_movements")
}

model Sale {
  id                String     @id @default(cuid())
  shopId            String     @map("shop_id")
  recordedByUserId  String?    @map("recorded_by_user_id")
  customerId        String?    @map("customer_id")
  customerNameSnapshot String? @map("customer_name_snapshot")
  receiptNumber     String     @map("receipt_number")
  status            SaleStatus @default(COMPLETED)
  subtotal          Decimal    @db.Decimal(12, 2)
  total             Decimal    @db.Decimal(12, 2)
  amountPaid        Decimal    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  outstandingBalance Decimal   @default(0) @map("outstanding_balance") @db.Decimal(12, 2)
  paymentMethod     PaymentMethod @map("payment_method")
  idempotencyKey    String?    @map("idempotency_key")
  notes             String?
  soldAt            DateTime   @default(now()) @map("sold_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  voidedAt          DateTime?  @map("voided_at")

  shop           Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  recordedByUser User?               @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  repayments     CustomerRepayment[]

  @@unique([shopId, receiptNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, soldAt])
  @@index([shopId, status])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id                 String  @id @default(cuid())
  saleId             String  @map("sale_id")
  productId          String  @map("product_id")
  productNameSnapshot String @map("product_name_snapshot")
  unitPriceSnapshot  Decimal @map("unit_price_snapshot") @db.Decimal(12, 2)
  unitCostSnapshot   Decimal @map("unit_cost_snapshot") @db.Decimal(12, 2)
  quantity           Decimal @db.Decimal(12, 3)
  lineTotal          Decimal @map("line_total") @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id            String        @id @default(cuid())
  shopId        String        @map("shop_id")
  saleId        String        @map("sale_id")
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(RECORDED)
  reference     String?
  paidAt        DateTime      @default(now()) @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([shopId, paidAt])
  @@index([saleId])
  @@map("payments")
}

model Expense {
  id          String        @id @default(cuid())
  shopId      String        @map("shop_id")
  description String
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  expenseDate DateTime      @map("expense_date") @db.Date
  note        String?
  status      ExpenseStatus @default(RECORDED)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  voidedAt    DateTime?     @map("voided_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([shopId, expenseDate])
  @@index([shopId, category])
  @@map("expenses")
}

model Customer {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  name      String
  phone     String?
  notes     String?
  removedAt DateTime? @map("removed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop       Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sales      Sale[]
  repayments CustomerRepayment[]

  @@index([shopId, name])
  @@index([shopId, phone])
  @@map("customers")
}

model CustomerRepayment {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  customerId String  @map("customer_id")
  saleId    String   @map("sale_id")
  amount    Decimal  @db.Decimal(12, 2)
  method    PaymentMethod @default(CASH)
  note      String?
  paidAt    DateTime @default(now()) @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([shopId, paidAt])
  @@index([customerId])
  @@index([saleId])
  @@map("customer_repayments")
}

model Subscription {
  id               String             @id @default(cuid())
  shopId           String             @unique @map("shop_id")
  status           SubscriptionStatus @default(NONE)
  trialStartsAt    DateTime?          @map("trial_starts_at")
  trialEndsAt      DateTime?          @map("trial_ends_at")
  startsAt         DateTime?          @map("starts_at")
  endsAt           DateTime?          @map("ends_at")
  graceEndsAt      DateTime?          @map("grace_ends_at")
  lastPaymentRef   String?            @map("last_payment_ref")
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}
